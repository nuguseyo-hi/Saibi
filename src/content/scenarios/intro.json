  "startNodeId": "arrival",
  "characters": [
    {
      "id": "elin",
      "name": "에밀리아",
      "description": "길 잃은 방문자",
      "standing": "/assets/characters/elin.svg",
      "flagKeys": [
        "trustedPlayer",
