  "narration": {
    "memory": [
      "아하, 이제 알겠군요! 이 가엾은 양의 마음에는 배신이라는 단어가 아주 깊숙이 박혀 있네요.",
      "정말이지, 인간이란 얼마나 어리석은 생물인지! 타인을 믿을 수 있다고 생각하다니 말이에요!",
      "자, 관객 분. 다음 장면으로 넘어가 볼까요?"
    ],
    "seal": [
      "어머나. 빛이 가린 것이 있었군요.",
      "그 기억이 옳은지는 중요하지 않아요. 무엇을 남길지는 우리의 몫이니까요.",
      "자, 더 깊은 곳의 문장도 만져 볼까요?"
    ],
    "resistance": [
      "아아, 신을 향하던 말이 끊겼군요. 저 아이가 버티고 있어요.",
      "하지만 이름이 지워진 자리는 오래 비어 있지 못한답니다.",
      "보세요. 새로운 믿음이 그 빈자리를 메우고 있어요."
    ],
    "corridor_intro": [
      "자, 먼저 그의 심상을 관찰해볼까요? 군데군데 비어있는 것이, 아직 현실을 부정하고 있는 모양이죠.",
      "마음껏 고쳐보세요, 관객 분. 이번 무대에서는 제가 손을 보태드릴 테니까요."
    ],
    "corridor_hint": [
      "관객 분, 비어있는 곳에 단어를 채워넣어주세요!"
    ],
    "corridor_door": [
      "그에게 차가운 현실을 일깨워 줍시다!"
    ],
    "corridor_sun": [
      "이런, 이번 무대는 밤이란 말입니다. 아직 태양이 떠오르려면 멀었어요!"
    ],
    "corridor_exit": [
      "동료를 믿을 수 없다면…… 이제 누구를 믿어야 할까요?"
    ],
    "chapel_intro": [
      "빛이 있는 곳에 길이 있다니, 안타깝게도! 자신이 아직도 빛의 아래에 있다고 믿고 싶은 모양이군요. 정작 밤에 올린 기도에 응답한 것은 관객 분인데 말이죠."
    ],
    "chapel_dark": [
      "좀 더 그럴 듯한 무대가 되었군요!"
    ],
    "chapel_stairs": [
      "훌륭합니다! 어린양도 깨닫겠지요. 빛이 응답하지 않을 때, 자신에게 손 뻗었던 이가 누구인지, 진정으로 길을 인도하는 이가 누구인지!"
    ],
    "chapel_sun": [
      "이런, 아직 나레이터는 무대에 등장할 시간이 아닌지라."
    ],
    "chapel_exit": [
      "길은 열렸군요. 이제 이 길을 걷는 아이가 누구인지, 마지막 한 줄을 읽어볼까요?"
    ]
